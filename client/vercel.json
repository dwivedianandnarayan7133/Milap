{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://milap-server-qt84.onrender.com/api/:match*"
    },
    {
      "source": "/studio/:match*",
      "destination": "/studio/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
